# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenHere

# Your Telegram numeric user id(s), comma-separated for multiple admins.
# Get yours from @userinfobot
ADMIN_IDS=474152178

# Fuzzy-match confidence threshold (0-100). Lower = more lenient matching.
MATCH_THRESHOLD=65

# Forward unanswered questions to admins as a DM
FORWARD_UNANSWERED=true

# SQLite file path (kept as-is for Render's persistent disk, see README)
DB_PATH=faq_bot.db

# Shown via /location, and as a button on /start and /help
MAPS_LINK=https://maps.app.goo.gl/ExwuLXpEFckRJnzXA

# Shown via /channel, and as a button on /start and /help
CHANNEL_LINK=https://t.me/medstarinternalclinic
